DEBUG=True
SECRET_KEY=replace-with-a-random-secret
API_URL=https://your-api-project.vercel.app
API_KEY=replace-with-the-same-random-api-key-as-the-api
ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.vercel.app
# Locally, use Vercel CLI to pull BLOB_STORE_ID and VERCEL_OIDC_TOKEN,
# or set BLOB_READ_WRITE_TOKEN for a connected public Vercel Blob store.
